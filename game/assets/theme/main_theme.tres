ProgressBar/styles/background = SubResource("track")
ProgressBar/styles/fill = SubResource("fill")
VScrollBar/styles/grabber = SubResource("scroll")
VScrollBar/styles/grabber_highlight = SubResource("scroll")
VScrollBar/styles/grabber_pressed = SubResource("scroll")
VScrollBar/styles/scroll = SubResource("empty")

SmallGoButton/base_type = &"Button"
SmallGoButton/fonts/font = ExtResource("display")
SmallGoButton/font_sizes/font_size = 16
SmallGoButton/colors/font_color = Color(1, 1, 1, 1)
SmallGoButton/colors/font_hover_color = Color(1, 1, 1, 1)
SmallGoButton/colors/font_pressed_color = Color(1, 1, 1, 1)
SmallGoButton/colors/font_hover_pressed_color = Color(1, 1, 1, 1)
SmallGoButton/styles/normal = SubResource("small_go")
SmallGoButton/styles/hover = SubResource("small_go")
SmallGoButton/styles/pressed = SubResource("small_go_pressed")
SmallGoButton/styles/hover_pressed = SubResource("small_go_pressed")
SmallGoButton/styles/focus = SubResource("empty")
